{
  "name": "Testes-AI-R",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "allure-commandline": "^2.46.1",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-wdio": "^9.31.3",
    "expect-webdriverio": "^6.1.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.70.1",
    "wdio-lambdatest-service": "^4.0.2"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "wdio run ./wdio.conf.ts",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "test:lambdatest": "wdio run ./wdio.lambdatest.conf.ts"
  }
}
